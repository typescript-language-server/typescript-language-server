{
  "name": "typescript-language-server",
  "version": "6.0.3",
  "description": "Language Server Protocol (LSP) implementation for TypeScript using tsserver",
  "author": "TypeFox and others",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typescript-language-server/typescript-language-server.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@12.17.0",
  "files": [
    "lib"
  ],
  "bin": {
    "typescript-language-server": "lib/cli.mjs"
  },
  "scripts": {
    "dev": "rimraf lib && rollup --config rollup.config.ts --configPlugin \"typescript={sourceMap: false}\" --watch",
    "build": "rimraf lib && rollup --config rollup.config.ts --configPlugin \"typescript={sourceMap: false}\"",
    "clean": "rimraf lib *.tsbuildinfo",
    "test": "cross-env CONSOLE_LOG_LEVEL=warning vitest --coverage",
    "test:commit": "cross-env CONSOLE_LOG_LEVEL=warning vitest run",
    "typecheck": "tsc",
    "lint": "oxlint --report-unused-disable-directives src && oxfmt --check src",
    "fix": "oxlint --fix src && oxfmt src",
    "size": "pnpm build && size-limit",
    "postversion": "git push --follow-tags",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@size-limit/file": "^14.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "5.0.5",
    "commander": "^15.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "fs-extra": "^11.4.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "p-debounce": "^6.0.0",
    "package-up": "^5.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.67.2",
    "semver": "^7.8.5",
    "size-limit": "^14.3.0",
    "source-map-support": "^0.5.21",
    "tempy": "^3.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "vscode-languageserver-textdocument": "1.0.16",
    "vscode-uri": "^3.2.0",
    "which": "^7.0.0",
    "why-is-node-running": "^3.2.3"
  }
}
